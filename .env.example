# Anthropic API key for Claude (used by legal classifier + report renderer)
ANTHROPIC_API_KEY=sk-ant-...

# Optional: provider for the legal check — anthropic (default) | gemini.
# Gemini's free tier on AI Studio gives you a like-for-like swap with google_search grounding.
# HOMEAGENT_LEGAL_PROVIDER=gemini
# GEMINI_API_KEY=...
# HOMEAGENT_GEMINI_MODEL=gemini-2.5-flash

# Optional: override paths
# HOMEAGENT_DB_PATH=data/homeagent.db
# HOMEAGENT_CACHE_DIR=data/cache
# HOMEAGENT_DRAFTS_DIR=drafts
# HOMEAGENT_REPORTS_DIR=reports

# Optional: model selection (defaults shown)
# HOMEAGENT_MODEL=claude-sonnet-4-6
